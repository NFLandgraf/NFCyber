inputDir = "E:\\TRY\\";
outputDir = inputDir + "out" + File.separator;

if (!File.exists(outputDir))
    File.makeDirectory(outputDir);

files = getFileList(inputDir);

setBatchMode(true);

for (i = 0; i < files.length; i++) {
    file = files[i];
    fileLower = toLowerCase(file);

	if (!(endsWith(fileLower, ".czi")))
        continue;
    

    open(inputDir + file);
    dot = lastIndexOf(file, ".");
	if (dot >= 0)
    	baseName = substring(file, 0, dot);
	else
    	baseName = file;

    // Split multi-channel image into separate channel images
    run("Split Channels");
	
    // Find the window corresponding to C2
    c1Title = findC1Title();
    c2Title = findC2Title();
    
    selectWindow(c1Title);
    resetMinAndMax();
    saveAs("Tiff", outputDir + baseName + "_Snd1.tif");
    
    selectWindow(c2Title);
    resetMinAndMax();
    saveAs("Tiff", outputDir + baseName + "_mKate.tif");

    // Threshold C2 and convert it to a binary mask
    setThreshold(20000, 65535);
    setOption("BlackBackground", true);
    run("Convert to Mask");

    // Save binary thresholded C2 channel
    saveAs("Tiff", outputDir + baseName + "_mKate_mask.tif");

    // Close C1, thresholded C2, and any other open images
    run("Close All");
}

setBatchMode(false);


// Returns the title of the C2 image generated by Split Channels
function findC2Title() {
    titles = getList("image.titles");

    for (j = 0; j < titles.length; j++) {
        if (startsWith(titles[j], "C2-"))
            return titles[j];
    }

    exit("Could not find a C2 channel.");
}

// Returns the title of the C2 image generated by Split Channels
function findC1Title() {
    titles = getList("image.titles");

    for (j = 0; j < titles.length; j++) {
        if (startsWith(titles[j], "C1-"))
            return titles[j];
    }

    exit("Could not find a C1 channel.");
}